<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>
 <!-- ======================= -->
<!-- FIM Windows Downloads -->
<!-- ======================= -->

<group name="syscheck,windows,fim">

  <rule id="200005" level="10">
    <if_sid>550</if_sid>
    <field name="file">C:\\Users\\VM\\Downloads</field>
    <description>File modified in Windows Downloads directory</description>
  </rule>

  <rule id="200006" level="10">
    <if_sid>554</if_sid>
    <field name="file">C:\\Users\\VM\\Downloads</field>
    <description>File added in Windows Downloads directory</description>
  </rule>

  <rule id="200007" level="10">
    <if_sid>553</if_sid>
    <field name="file">C:\\Users\\VM\\Downloads</field>
    <description>File deleted in Windows Downloads directory</description>
  </rule>

<rule id="100016" level="3">
  <match>Linux-Sysmon</match>
  <description>Sysmon for Linux event collected</description>
  <group>syslog,journald,json</group>
</rule>

</group>
<group name="ai_alerts,">
  <!-- Base rule: AI đọc JSON từ active-responses.log (PHẢI ĐẶT TRƯỚC 100010) -->
  <rule id="100011" level="3">
    <decoded_as>json</decoded_as>
    <field name="ai_prediction">\.+</field>
    <description>AI Analysis: Dữ liệu từ AI model</description>
  </rule>

  <!-- Rule cho test log đầu vào (không phải từ active-responses) -->
  <rule id="100010" level="3">
    <match>AI_TEST</match>
    <description>AI test log detected - Đang phân tích...</description>
    <group>web,apache,nginx,ids,ai_test_group,</group>
  </rule>

  <!-- XSS Detection - Level 14 (High Confidence) -->
  <rule id="100012" level="14">
    <if_sid>100011</if_sid>
    <field name="ai_prediction">^XSS$</field>
    <field name="ai_confidence_pct">^9[0-9]\.[0-9]|^100\.0</field>
    <description>🚨 AI PHÁT HIỆN TẤN CÔNG XSS - Độ tin cậy cao: $(ai_confidence_pct)%</description>
    <group>attack,xss,ai_detection,</group>
  </rule>

  <!-- SQLi Detection - Level 14 (High Confidence) -->
  <rule id="100013" level="14">
    <if_sid>100011</if_sid>
    <field name="ai_prediction">^SQLi$</field>
    <field name="ai_confidence_pct">^9[0-9]\.[0-9]|^100\.0</field>
    <description>🚨 AI PHÁT HIỆN TẤN CÔNG SQL INJECTION - Độ tin cậy cao: $(ai_confidence_pct)%</description>
    <group>attack,sqli,ai_detection,</group>
  </rule>

  <!-- Command Injection Detection - Level 14 (High Confidence) -->
  <rule id="100017" level="14">
    <if_sid>100011</if_sid>
    <field name="ai_prediction">^CMDi$</field>
    <field name="ai_confidence_pct">^9[0-9]\.[0-9]|^100\.0</field>
    <description>🚨 AI PHÁT HIỆN TẤN CÔNG COMMAND INJECTION - Độ tin cậy cao: $(ai_confidence_pct)%</description>
    <group>attack,cmdi,ai_detection,</group>
  </rule>

  <!-- Suspicious Detections - Level 12 (Medium Confidence) -->
  <rule id="100019" level="12">
    <if_sid>100011</if_sid>
    <field name="ai_prediction">^XSS$|^SQLi$|^CMDi$</field>
    <field name="ai_confidence_pct">^8[0-9]\.[0-9]</field>
    <description>⚠️ AI NGHI VẤN TẤN CÔNG $(ai_prediction) - Độ tin cậy: $(ai_confidence_pct)% | Cần kiểm tra lại</description>
    <group>attack,ai_detection,suspicious,</group>
  </rule>

  <!-- Generic Attack (fallback) - Level 7 -->
  <rule id="100014" level="7">
    <if_sid>100011</if_sid>
    <field name="ai_is_attack">^true$</field>
    <description>⚠️ AI CẢNH BÁO: Phát hiện $(ai_prediction) - Độ tin cậy: $(ai_confidence_pct)%</description>
    <group>attack,ai_detection,</group>
  </rule>


  <!-- Hook Rule: Forward ALL Web Logs to AI for analysis -->
  <rule id="100018" level="3">
    <if_sid>31100, 31101, 31103, 31106, 31108, 31122, 31151, 31164</if_sid>
    <description>Web Access Log - AI Analysis Hook (Auto-Triggered)</description>
    <group>ai_analysis_trigger,web,attack,</group>
  </rule>

  <!-- Benign - Level 3 (Info) -->
  <rule id="100015" level="3">
    <if_sid>100011</if_sid>
    <field name="ai_prediction">^Benign$</field>
    <description>AI: Request an toàn (Benign: $(ai_details.benign_pct)%)</description>
    <group>ai_detection,</group>
  </rule>

</group>

